  find_java
  run_suite "$1" "" "" "${1#"${CCM_SOURCE:-$SCRIPT_DIR/..}"/}"
}

# -------------------------------------------------------------------- new ---

cmd_new() {
  if [ $# -eq 0 ] && interactive; then cmd_add; return; fi
  [ $# -ge 2 ] || die "usage: ccm new course <name> | ccm new chapter|lesson|exercise <parent address> <name>"
  local kind=$1 parent name want dir pre="" max=0 any=0 d n new tmpl
  shift
  TREE=$(local_source) || TREE=$(git rev-parse --show-toplevel 2>/dev/null) || true
  if [ -z "$TREE" ] || [ ! -d "$TREE/courses" ]; then die "ccm new must be run inside a curriculum checkout"; fi
  case $kind in
    course)   [ $# -eq 1 ] || die "usage: ccm new course <name>"; parent=courses; name=$1; want=root ;;
    chapter)  [ $# -eq 2 ] || die "usage: ccm new chapter <course> <name>"; want=course ;;
    lesson)   [ $# -eq 2 ] || die "usage: ccm new lesson <chapter> <name>"; want=chapter ;;
    exercise) [ $# -eq 2 ] || die "usage: ccm new exercise <lesson> <name>"; want=lesson ;;
    *) die "ccm new: unknown kind '$kind' (course, chapter, lesson, exercise)" ;;
  esac
  if [ "$kind" != course ]; then
    parent=$(resolve "$1"); name=$2
    [ "$(kind_of "$parent")" = "$want" ] || die "$1 is a $(kind_of "$parent"), expected a $want"
  fi
  [[ $name =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "name must be lowercase-with-hyphens, e.g. if-statements"
  local why
  if why=$(name_conflict "$name"); then die "$why. Pick another name."; fi
  dir="$TREE/$parent"
  if [ "$kind" = exercise ]; then dir="$dir/exercises"; pre=e; fi
  mkdir -p "$dir"
  for d in "$dir"/"$pre"[0-9]*-*/; do
    [ -d "$d" ] || continue
    any=1
    n=$(dnum "$(basename "$d")"); [ "$n" -gt "$max" ] && max=$n
    [ "$(dslug "$(basename "$d")")" = "$name" ] && die "'$name' already exists in $(addr_of "$parent")"
  done
  # Courses start at 00; chapters, lessons and exercises start at 01.
  if [ "$kind" = course ] && [ "$any" = 0 ]; then n=0; else n=$((max + 1)); fi
  new=$(printf '%s%02d-%s' "$pre" "$n" "$name")
  tmpl="$TREE/shared/templates/$kind"
  [ -d "$tmpl" ] || die "missing template $tmpl"
  cp -R "$tmpl" "$dir/$new"
  if [ "$kind" = lesson ]; then
    local course=${parent#courses/}; course=${course%%/*}
    [ "$(yaml_scalar "$TREE/courses/$course/course.yaml" slides)" = true ] || rm -f "$dir/$new/slides.md"
  fi
  local rel=${dir#"$TREE"/}/$new
  say "${GREEN}created${RESET} $rel  ($(addr_of "$rel"))"
}

# ------------------------------------------------------- instructor tools ---
# Front ends for the Python tools in tools/. They only work in a clone of the repo.

repo_root() {  # repo_root <command name>
  local r
  r=$(local_source) || r=$(git rev-parse --show-toplevel 2>/dev/null) || r=""
  if [ -z "$r" ] || [ ! -d "$r/tools/lms" ]; then
    die "ccm $1 is for instructors: run it inside a clone of $CCM_REPO"
  fi
  echo "$r"
}

# Sets PY to a Python with the tools' requirements, making <repo>/.venv the first time
# (and again whenever tools/requirements.txt changes).
ensure_python() {  # ensure_python <repo>
  local venv="$1/.venv" req="$1/tools/requirements.txt" stamp
  command -v python3 >/dev/null 2>&1 || die "python3 is not installed"
  stamp="$venv/.requirements"
  if [ ! -x "$venv/bin/python" ] || [ ! -f "$stamp" ] || ! cmp -s "$req" "$stamp"; then
    # shellcheck disable=SC2016  # the script gets its values as $1, $2, ...
    ui_spin "Setting up Python for the tools (only needed once)..." sh -c '
      [ -x "$1/bin/python" ] || python3 -m venv "$1" || { echo "could not create $1 (on Debian/Ubuntu: sudo apt install python3-venv)"; exit 1; }
      "$1/bin/python" -m pip install --quiet --disable-pip-version-check -r "$2"' _ "$venv" "$req" ||
      die "couldn't set up Python for the tools"
    cp "$req" "$stamp"
  fi
  PY="$venv/bin/python"
  export PYTHONDONTWRITEBYTECODE=1
}

run_tool() {  # run_tool <command name> <script under tools/> [args...]
  local name=$1 script=$2 root
  shift 2
  root=$(repo_root "$name")
  ensure_python "$root"
  exec "$PY" "$root/tools/$script" "$@"
}

cmd_remove() {
  local yes=0 target="" rel kind addr title files refs
  while [ $# -gt 0 ]; do
    case $1 in
      -y|--yes) yes=1 ;;
      -*) die "ccm remove: unknown option $1" ;;
      *) [ -z "$target" ] || die "ccm remove takes one thing at a time"; target=$1 ;;
    esac
    shift
  done
  TREE=$(repo_root remove)
  if [ -z "$target" ]; then
    interactive || die "usage: ccm remove <address|name> [-y]   (a course, chapter, lesson or exercise)"
    target=$(pick_any "What do you want to delete?")
  fi
  rel=$(resolve "$target")
  kind=$(kind_of "$rel")
  case $kind in course|chapter|lesson|exercise) ;; *) die "can only remove a course, chapter, lesson or exercise" ;; esac
  addr=$(addr_of "$rel")
  title=$(title_of "$TREE/$rel" "$kind")
  files=$(find "$TREE/$rel" -type f | wc -l | tr -d ' ')

  ui_header "Delete $kind $addr${title:+  $title}" danger
  say "  $rel  ($files file(s))"
  # lessons elsewhere that link into what's being removed
  refs=$(grep -rlF --include='*.md' "$(basename "$rel")/" "$TREE/courses" 2>/dev/null |
         grep -v "^$TREE/$rel/" | sed "s|^$TREE/||" || true)
  if [ -n "$refs" ]; then
    say "${YELLOW}  These files link to it (fix them after):${RESET}"
    printf '%s\n' "$refs" | sed 's/^/    /' >&2
  fi
  ensure_python "$TREE"
  "$PY" "$TREE/tools/lms/forget.py" "$TREE/$rel" >&2 || true
  say "  This won't delete anything on Charging Courses. You'll need to remove those pages on the site."
  say "  The other folders keep their numbers. Use ccm mv if you want to renumber them."

  if [ "$yes" = 0 ]; then
    [ -t 0 ] || die "not removing without confirmation (use -y)"
    ui_typed "$(dslug "$(basename "$rel")")" "delete it" || die "cancelled, nothing was removed"
  fi
  "$PY" "$TREE/tools/lms/forget.py" --apply "$TREE/$rel" || die "could not update tools/lms/ids.yaml"
  rm -rf "${TREE:?}/$rel"
  say "${GREEN}removed${RESET} $rel"
  if git -C "$TREE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    say "  (if it was committed, you can bring it back with: git restore $rel)"
  fi
}

cmd_mv() {
  local src args=() a
  TREE=$(repo_root mv)
  if [ $# -eq 0 ]; then
    interactive || die "usage: ccm mv <address> [new-name | new-position] [--into <address>] [-y]"
    mv_menu
    return
  fi
  src=$(resolve "$1"); shift
  while [ $# -gt 0 ]; do
    a=$1
    case $a in
      --name) shift; args+=(--name "${1:?--name needs a name}") ;;
      --to|--position) shift; args+=(--position "${1:?--to needs a number}") ;;
      --into) shift; args+=(--into "$TREE/$(resolve "${1:?--into needs an address}")") ;;
      -y|--yes) args+=(--yes) ;;
      -*) die "ccm mv: unknown option $a" ;;
      *) if is_num "$a"; then args+=(--position "$a"); else args+=(--name "$a"); fi ;;
    esac
    shift
  done
  [ "${#args[@]}" -gt 0 ] || die "tell ccm mv what to change: a new name, a new position, or --into <address>"
  ensure_python "$TREE"
  exec "$PY" "$TREE/tools/move.py" "$TREE/$src" "${args[@]}"
}

# ccm mv with nothing: pick what to move, then what to do with it.
mv_menu() {
  local src kind parent_kind what name pos into labels=() d n=0 sibs here
  src=$(pick_any "What do you want to rename or move?")
  kind=$(kind_of "$src")
  case $kind in course|chapter|lesson|exercise) ;; *) die "pick a course, chapter, lesson or exercise" ;; esac
  case $kind in course) parent_kind=root ;; chapter) parent_kind=course ;; lesson) parent_kind=chapter ;; exercise) parent_kind=lesson ;; esac
  local choices=("rename it" "move it up or down")
  [ "$kind" != course ] && choices+=("move it to another $parent_kind")
  what=$(ui_choose "What do you want to do with $(addr_of "$src")?" "${choices[@]}") || die "cancelled"
  ensure_python "$TREE"
  case $what in
    rename*)
      name=$(ask_slug "$kind" "$(dslug "$(basename "$src")")" "$src")
      exec "$PY" "$TREE/tools/move.py" "$TREE/$src" --name "$name" ;;
    "move it up"*)
      sibs=$(dirname "$src")
      for d in "$TREE/$sibs"/[0-9e]*-*/; do
        [ -d "$d" ] || continue
        n=$((n + 1)); d=${d%/}
        here=""; [ "${d#"$TREE"/}" != "$src" ] || here="  (here now)"
        labels+=("$n  $(dslug "$(basename "$d")")  $(title_of "$d" "$kind")$here")
      done
      pos=$(ui_choose "Where should it go?" "${labels[@]}") || die "cancelled"
      exec "$PY" "$TREE/tools/move.py" "$TREE/$src" --position "${pos%% *}" ;;
    *)
      into=$(pick_kind "Move it into which $parent_kind?" "$parent_kind")
      exec "$PY" "$TREE/tools/move.py" "$TREE/$src" --into "$TREE/$into" ;;
  esac
}

cmd_pull() {
  local args=() a
  TREE=$(repo_root pull)
  for a in "$@"; do
    case $a in -y|--yes) args+=(--yes) ;; *) args+=("$TREE/$(resolve "$a")") ;; esac
  done
  ensure_python "$TREE"
  have_gum || true   # the pickers in pull.py use the same gum (CCM_GUM)
  exec "$PY" "$TREE/tools/lms/pull.py" ${args[@]+"${args[@]}"}
}

ids_get() {  # ids_get <section> <key>   (from tools/lms/ids.yaml)
  local f="$TREE/tools/lms/ids.yaml"
  [ -f "$f" ] || return 0
  SEC=$1 KEY=$2 awk 'BEGIN { s = ENVIRON["SEC"] ":"; k = ENVIRON["KEY"] }
    index($0, s) == 1 { on = 1; next }
    /^[^ #]/ { on = 0 }
    on && index($0, "  " k ": ") == 1 { v = substr($0, length(k) + 5); sub(/[ \t]+#.*/, "", v); print v; exit }' "$f"
}

cmd_open() {
  local rel kind course cid act="" url="" d
  current_tree
  if [ $# -gt 0 ]; then
    rel=$(resolve "$1")
  else
    if d=$(nearest_marker "$PWD"); then
      rel=$(marker_get "$d" path)
    else
      interactive || die "usage: ccm open <address>   (or run it inside something you downloaded)"
      rel=$(pick_any "What do you want to open?")
    fi
  fi
  kind=$(kind_of "$rel")
  course=$(printf %s "${rel#courses/}" | cut -d/ -f1)
  cid=$(ids_get courses "$course")
  [ -n "$cid" ] || die "$(addr_of "$rel") isn't on Charging Courses yet"
  case $kind in
    course) url="$SITE/course/$cid" ;;
    chapter)
      for d in "$TREE/$rel"/[0-9]*-*/; do
        d=${d%/}
        act=$(ids_get lessons "${d#"$TREE"/courses/}")
        [ -n "$act" ] && break
      done ;;
    lesson) act=$(ids_get lessons "${rel#courses/}") ;;
    exercise)
      if [ "$(yaml_scalar "$TREE/$rel/prompt.md" type)" = homework ]; then
        act=$(ids_get homework "$(dslug "$(basename "$rel")")")
      fi
      [ -n "$act" ] || act=$(ids_get lessons "$(dirname "$(dirname "${rel#courses/}")")") ;;
  esac
  if [ -z "$url" ]; then
    [ -n "$act" ] || die "$(addr_of "$rel") isn't on Charging Courses yet"
    url="$SITE/course/$cid/activity/$act"
  fi
  echo "$url"
  if [ "$(uname)" = Darwin ]; then open "$url"
  elif [ -n "${BROWSER:-}" ]; then "$BROWSER" "$url" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then xdg-open "$url" >/dev/null 2>&1 &
  fi
}

doctor_ok()  { say "  ${GREEN}✓${RESET} $*"; }
doctor_no()  { say "  ${RED}✗${RESET} $*"; DOCTOR_BAD=1; }
doctor_meh() { say "  ${YELLOW}-${RESET} $*"; }

cmd_doctor() {
  local v root=""
  DOCTOR_BAD=0
  ui_header "ccm $CCM_VERSION"
  if command -v curl >/dev/null 2>&1; then doctor_ok "curl"; else doctor_no "curl isn't installed"; fi
  local net
  tmpdir
  net="$CCM_TMP/net-$RANDOM"
  # shellcheck disable=SC2016  # the script gets its values as $1, $2, ...
  ui_spin "Checking the internet..." sh -c '
    curl -fsI --max-time 8 https://codeload.github.com >/dev/null 2>&1 && echo ok > "$1.github"
    curl -fsI --max-time 8 "$2" >/dev/null 2>&1 && echo ok > "$1.site"; exit 0' _ "$net" "$SITE" || true
  if [ -f "$net.github" ]; then doctor_ok "can reach GitHub (for ccm get)"
  else doctor_no "can't reach GitHub, so ccm get won't work (check your internet)"; fi
  if [ -f "$net.site" ]; then doctor_ok "can reach Charging Courses"; else doctor_no "can't reach $SITE"; fi
  if [ "${CCM_NO_GUM:-}" = 1 ]; then doctor_meh "gum is turned off (CCM_NO_GUM=1)"
  elif find_gum; then doctor_ok "gum for menus ($GUM)"
  else doctor_meh "gum couldn't be downloaded, so ccm uses plain menus"; fi
  v=$( (find_java >/dev/null 2>&1 && javac -version 2>&1) | grep -Eo '[0-9]+' | head -1 || true)
  if [ -n "$v" ] && [ "$v" -ge 17 ]; then doctor_ok "Java $v (for ccm test)"
  else doctor_no "Java 17+ not found (needed for ccm test). Labs already has it; otherwise install a JDK or WPILib."; fi
  if is_instructor; then
    ui_header "Instructor"
    if root=$(repo_root doctor 2>/dev/null); then doctor_ok "repo clone at $root"
    else root=""; doctor_no "not inside a clone of $CCM_REPO (instructor commands need one)"; fi
    if command -v git >/dev/null 2>&1; then doctor_ok "git"; else doctor_no "git isn't installed"; fi
    if python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
      doctor_ok "Python $(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
    else doctor_no "Python 3.9+ not found"; fi
    if [ -n "$root" ]; then
      if [ -x "$root/.venv/bin/python" ]; then doctor_ok "tools' Python is set up (.venv)"
      else doctor_meh "tools' Python gets set up the first time you need it"; fi
      if [ -n "${CC_API_TOKEN:-}" ] || grep -q '^CC_API_TOKEN=.' "$root/.env" 2>/dev/null; then
        if [ -x "$root/.venv/bin/python" ] && (cd "$root" && .venv/bin/python -c '
import sys; sys.path.insert(0, "tools/lms")
import publish as P
P.Api(P.token()).get("/courses/course_%s/meta?slim=true" % next(iter(P.IDS["courses"].values())))
' >/dev/null 2>&1); then doctor_ok "API token works (for ccm publish)"
        else doctor_no "the API token didn't work (make a new one in Dashboard → Developers → API Access)"; fi
      else doctor_no "no API token yet (add CC_API_TOKEN=lh_... to .env for ccm publish)"; fi
    fi
  fi
  if [ "$DOCTOR_BAD" = 0 ]; then say "${GREEN}all good${RESET}"; fi
  return "$DOCTOR_BAD"
}

cmd_release() {
  local dry=0 tag="" a root branch last year news
  local empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  for a in "$@"; do
    case $a in
      --dry-run|-n) dry=1 ;;
      v[0-9]*) tag=$a ;;
      *) die "usage: ccm release [vYYYY.N] [--dry-run]" ;;
    esac
  done
  root=$(repo_root release)
  cd "$root"
  [ -z "$(git status --porcelain)" ] || die "commit or stash your changes first (see: git status)"
  git fetch --tags --quiet origin 2>/dev/null || warn "couldn't get the tags from GitHub, so using the ones you have"
  branch=$(git branch --show-current)
  last=$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null || true)
  year=$(date +%Y)
  if [ -z "$tag" ]; then
    if [[ $last =~ ^v$year\.([0-9]+)$ ]]; then tag="v$year.$((BASH_REMATCH[1] + 1))"; else tag="v$year.1"; fi
  fi
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then die "$tag already exists"; fi

  ui_header "Release $tag"
  say "from ${branch:-detached HEAD} (last release: ${last:-none})"
  [ "$branch" = main ] || warn "you're on '$branch'. Releases usually come from main."
  say "Changes since ${last:-the beginning}:"
  git log --oneline "${last:+$last..}HEAD" | head -15 | sed 's/^/  /' >&2
  news=$(git diff --name-status "${last:-$empty_tree}" HEAD -- courses |
         awk '$1 == "A" && $2 ~ /prompt\.md$/ { print $2 }' | sed 's#/prompt.md##; s#.*/e[0-9]*-##' | tr '\n' ' ')
  [ -z "$news" ] || say "New exercises students can ccm get: $news"
  ensure_python "$root"
  # shellcheck disable=SC2016  # the script gets its values as $1, $2, ...
  ui_spin "Checking the curriculum and running every exercise's tests..." sh -c '
    "$1" tools/validate/validate.py --strict || { echo; echo "ccm validate found problems (a release needs 0 errors and 0 warnings)"; exit 1; }
    bash tools/check-exercises.sh || { echo; echo "exercise tests failed (see: ccm check)"; exit 1; }' _ "$PY" ||
    die "fix the problems above, then try again"
  say "${GREEN}checks passed${RESET}"
  if [ "$dry" = 1 ]; then say "dry run: would tag and push $tag"; return; fi
  [ -t 0 ] || die "not releasing without confirmation"
  ui_typed "$tag" "tag and push it" || die "cancelled"
  git tag -a "$tag" -m "Release $tag"
  git push origin "$tag"
  say "${GREEN}released $tag${RESET}. GitHub is building it now: https://github.com/$CCM_REPO/actions"
}

# Everything in the curriculum, one per line: <address>  <title>  · <kind>
search_index() {
  local d rel kind
  find "$TREE/courses" -mindepth 1 -maxdepth 5 -type d \( -name '[0-9]*-*' -o -name 'e[0-9]*-*' \) 2>/dev/null | sort |
    while IFS= read -r d; do
      rel=${d#"$TREE"/}; kind=$(kind_of "$rel")
      case $kind in course|chapter|lesson|exercise) ;; *) continue ;; esac
      printf '%s  · %s\n' "$(label_of "$rel")" "$kind"
    done
}

cmd_search() {
  local query="$*" line addr what lines
  current_tree
  if have_gum; then
    line=$(ui_bg "Loading the curriculum..." search_index | "$GUM" filter --placeholder "Search lessons and exercises" --value "$query" \
           --header "Type to search, enter to pick" --height 15) || die "cancelled"
    addr=${line%% *}
    what=$(ui_choose "$line" "Download it" "Read it here" "Open it on Charging Courses" "See what's in it") || die "cancelled"
    case $what in
      Download*) cmd_get "$addr" ;;
      Read*)     cmd_show "$addr" ;;
      Open*)     cmd_open "$addr" ;;
      *)         cmd_list "$addr" ;;
    esac
    return
  fi
  [ -n "$query" ] || die "usage: ccm search <words>"
  lines=$(search_index | grep -iF -- "${query%% *}" || true)
  for w in $query; do lines=$(printf '%s\n' "$lines" | grep -iF -- "$w" || true); done
  if [ -n "$lines" ]; then
    printf '%s\n' "$lines" | while IFS= read -r line; do
      printf '%s%s%s%s\n' "$BOLD$EMERALD" "${line:0:12}" "$RESET" "${line:12}"
    done
  fi
  local hits
  hits=$(grep -rilF --include=lecture.md --include=prompt.md -- "$query" "$TREE/courses" 2>/dev/null | sort | head -10)
  if [ -n "$hits" ]; then
    say "${DIM}Also mentioned in:${RESET}"
    printf '%s\n' "$hits" | while IFS= read -r f; do
      d=$(dirname "$f"); rel=${d#"$TREE"/}
      printf '  %s\n' "$(label_of "$rel")"
    done
  fi
  [ -n "$lines$hits" ] || say "nothing found for '$query'"
}

cmd_show() {  # read a lesson or exercise in the terminal
  local rel d f text
  current_tree
  if [ $# -gt 0 ]; then rel=$(resolve "$1")
  elif d=$(nearest_marker "$PWD"); then rel=$(marker_get "$d" path)
  else
    interactive || die "usage: ccm show <address>"
    rel=$(pick_any "What do you want to read?")
  fi
  case $(kind_of "$rel") in
    exercise) f="$TREE/$rel/prompt.md" ;;
    lesson)   f="$TREE/$rel/lecture.md" ;;
    *) cmd_list "$rel"; return ;;
  esac
  [ -f "$f" ] || die "nothing to read for $(addr_of "$rel")"
  text="# $(addr_of "$rel")  $(title_of "$TREE/$rel" "$(kind_of "$rel")")
$(awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { fm = 0; next } !fm' "$f")"
  if have_gum && [ -t 1 ]; then
    printf '%s\n' "$text" | "$GUM" format --theme dark | "$GUM" pager --soft-wrap
  elif [ -t 1 ] && command -v less >/dev/null 2>&1; then
    printf '%s\n' "$text" | less -R
  else
    printf '%s\n' "$text"
  fi
}

cmd_check() {
  local root
  root=$(repo_root check)
  exec bash "$root/tools/check-exercises.sh" "$@"
}

# ------------------------------------------------------------- instructor ---

in_clone() {
  local r
  r=$(local_source 2>/dev/null) || r=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -d "$r/tools/lms" ]
}

# Instructor mode shows the instructor commands in `ccm help`. It's on inside a clone of the
# repo, after `ccm instructor on`, or with CCM_INSTRUCTOR=1 (CCM_INSTRUCTOR=0 turns it off).
is_instructor() {
  case "${CCM_INSTRUCTOR:-}" in
    0|no|false|off) return 1 ;;
    "") ;;
    *) return 0 ;;
  esac
  [ -f "$CCM_CONFIG/instructor" ] || in_clone
}

cmd_instructor() {
  case "${1:-status}" in
    on)  mkdir -p "$CCM_CONFIG" && touch "$CCM_CONFIG/instructor"; say "instructor mode is on (ccm help shows everything)" ;;
    off) rm -f "$CCM_CONFIG/instructor"; say "instructor mode is off${DIM} (it's still on inside a clone of the repo)${RESET}" ;;
    status) if is_instructor; then say "instructor mode is on"; else say "instructor mode is off (turn it on with: ccm instructor on)"; fi ;;
    *) die "usage: ccm instructor on|off|status" ;;
  esac
}

# -------------------------------------------------------------------- add ---
# `ccm add`: asks what you want to add and makes it from the templates. Uses gum
# (github.com/charmbracelet/gum) if it's installed, and plain prompts if not.

gum_sha256() {  # checksums from gum's release page (checksums.txt)
  case $1 in
    Darwin_arm64)  echo 4777a69b1170b8db23c95d5889fb32186cfda1a3ac950d339aa17e3513633890 ;;
    Darwin_x86_64) echo 5374966c7c7199ea879fcaa525ddc6d447a098d3d35496e430a9a1ef38d30485 ;;
    Linux_arm64)   echo 8ebf8b54ec1e8c81f2bb58b59ff9b70998186a4d11375f0cf357b80e0ccfa1d5 ;;
    Linux_x86_64)  echo d842e06d93dbed90af48cb8dd10698db6f22e331fc40346bb37bbc753109edc2 ;;
    *) return 1 ;;
  esac
}

# find_gum: sets GUM to a gum binary. Uses one that's installed, or downloads gum into the
# ccm cache the first time (about 14 MB). If that can't happen, ccm uses plain prompts.
find_gum() {
  [ "${CCM_NO_GUM:-}" != 1 ] || return 1
  [ "$GUM" != none ] || return 1
  [ -z "$GUM" ] || return 0
  local bin="$CCM_CACHE/bin/gum-$GUM_VERSION" skip="$CCM_CACHE/bin/.no-gum" os arch platform sum tgz
  if command -v gum >/dev/null 2>&1; then
    GUM=$(command -v gum)
  elif [ -x "$bin" ]; then
    GUM=$bin
  elif [ -f "$skip" ] && [ -n "$(find "$skip" -mtime -1 2>/dev/null)" ]; then
    GUM=none; return 1   # the download failed recently; don't retry every time
  else
    os=$(uname -s); arch=$(uname -m)
    case $arch in aarch64|arm64) arch=arm64 ;; x86_64|amd64) arch=x86_64 ;; esac
    platform="${os}_${arch}"
    mkdir -p "$CCM_CACHE/bin"
    if ! sum=$(gum_sha256 "$platform"); then touch "$skip"; GUM=none; return 1; fi
    tmpdir
    tgz="$CCM_TMP/gum.tgz"
    say "${DIM}Getting gum for menus (one time)...${RESET}"
    if curl -fsSL --max-time 60 "https://github.com/charmbracelet/gum/releases/download/v$GUM_VERSION/gum_${GUM_VERSION}_${platform}.tar.gz" -o "$tgz" &&
       [ "$(sha256 "$tgz")" = "$sum" ] &&
       tar -xzf "$tgz" -C "$CCM_TMP" "gum_${GUM_VERSION}_${platform}/gum" 2>/dev/null; then
      mv "$CCM_TMP/gum_${GUM_VERSION}_${platform}/gum" "$bin" && chmod +x "$bin"
      GUM=$bin
    else
      touch "$skip"; GUM=none; return 1
    fi
  fi
  export CCM_GUM=$GUM   # the Python tools use the same gum
  gum_theme
}

gum_theme() {  # Charging Courses colors for every gum component (your own GUM_* settings win)
  local kv name
  for kv in \
    GUM_CHOOSE_CURSOR="› " GUM_CHOOSE_CURSOR_FOREGROUND=$C_PRIMARY GUM_CHOOSE_SELECTED_FOREGROUND=$C_PRIMARY \
    GUM_CHOOSE_HEADER_FOREGROUND=$C_LIGHT \
    GUM_CONFIRM_PROMPT_FOREGROUND=$C_LIGHT GUM_CONFIRM_SELECTED_BACKGROUND=$C_DARK \
    GUM_CONFIRM_SELECTED_FOREGROUND=$C_MINT GUM_CONFIRM_UNSELECTED_BACKGROUND=$C_NAVY_DARK \
    GUM_CONFIRM_UNSELECTED_FOREGROUND=$C_MUTED \
    GUM_INPUT_PROMPT="› " GUM_INPUT_PROMPT_FOREGROUND=$C_PRIMARY GUM_INPUT_CURSOR_FOREGROUND=$C_PRIMARY \
    GUM_INPUT_HEADER_FOREGROUND=$C_LIGHT GUM_INPUT_PLACEHOLDER_FOREGROUND=$C_FAINT \
    GUM_FILTER_PROMPT="› " GUM_FILTER_PROMPT_FOREGROUND=$C_PRIMARY GUM_FILTER_INDICATOR_FOREGROUND=$C_PRIMARY \
    GUM_FILTER_MATCH_FOREGROUND=$C_LIGHT GUM_FILTER_HEADER_FOREGROUND=$C_LIGHT \
    GUM_FILTER_PLACEHOLDER_FOREGROUND=$C_FAINT GUM_FILTER_CURSOR_TEXT_FOREGROUND=$C_MINT \
    GUM_SPIN_SPINNER=dot GUM_SPIN_SPINNER_FOREGROUND=$C_PRIMARY GUM_SPIN_TITLE_FOREGROUND=$C_MUTED \
    GUM_WRITE_CURSOR_FOREGROUND=$C_PRIMARY GUM_WRITE_HEADER_FOREGROUND=$C_LIGHT \
    GUM_WRITE_PROMPT_FOREGROUND=$C_DARK GUM_WRITE_PLACEHOLDER_FOREGROUND=$C_FAINT \
    GUM_TABLE_HEADER_FOREGROUND=$C_LIGHT GUM_TABLE_BORDER_FOREGROUND=$C_NAVY \
    GUM_TABLE_SELECTED_FOREGROUND=$C_MINT GUM_TABLE_SELECTED_BACKGROUND=$C_DARK \
    GUM_PAGER_MATCH_FOREGROUND=$C_MINT GUM_PAGER_MATCH_BACKGROUND=$C_DARK \
    GUM_PAGER_MATCH_HIGH_FOREGROUND=$C_MINT GUM_PAGER_MATCH_HIGH_BACKGROUND=$C_NAVY \
    GUM_PAGER_HELP_FOREGROUND=$C_FAINT; do
    name=${kv%%=*}
    [ -z "${!name:-}" ] || continue
    export "${kv?}"
  done
}

# have_gum: true when gum can be used here. stdout isn't checked because the ui_* helpers run
# inside $(...), and gum draws on the terminal anyway.
have_gum() { [ -t 0 ] && [ -t 2 ] && find_gum; }

# ui_header <text> [danger]: a title badge in Charging Courses colors.
ui_header() {
  if have_gum; then
    local bg=$C_NAVY
    [ -z "${2:-}" ] || bg=$C_DANGER
    "$GUM" style --bold --foreground "$C_MINT" --background "$bg" --padding "0 1" --margin "1 0 0 0" "$1" >&2
  else
    local fg=$NAVY
    [ -z "${2:-}" ] || fg=$RED
    say ""; say "${BOLD}$fg$1${RESET}"
  fi
}

ui_choose() {  # ui_choose <header> <option>...   -> prints the chosen option
  local header=$1 i=1 opt pick
  shift
  if have_gum; then "$GUM" choose --header "$header" "$@"; return; fi
  say "$header"
  for opt in "$@"; do say "  $i) $opt"; i=$((i + 1)); done
  while :; do
    printf '> ' >&2; read -r pick || return 1
    if is_num "$pick" && [ "$pick" -ge 1 ] && [ "$pick" -le $# ]; then
      shift $((pick - 1)); echo "$1"; return
    fi
    say "pick a number from 1 to $#"
  done
}

ui_multi() {  # ui_multi <header> <preselected,comma,list> <option>...  -> one choice per line
  local header=$1 selected=$2 opt answer
  shift 2
  if have_gum; then "$GUM" choose --no-limit --header "$header" --selected "$selected" "$@"; return; fi
  say "$header"
  for opt in "$@"; do
    case ",$selected," in *",$opt,"*) answer=Y ;; *) answer=n ;; esac
    printf '  %s? [%s] ' "$opt" "$([ "$answer" = Y ] && echo Y/n || echo y/N)" >&2
    read -r pick || return 1
    pick=${pick:-$answer}
    case $pick in [Yy]*) echo "$opt" ;; esac
  done
}

ui_input() {  # ui_input <prompt> [placeholder] [starting text]
  local answer
  if have_gum; then "$GUM" input --header "$1" --placeholder "${2:-}" --value "${3:-}"; return; fi
  printf '%s%s: ' "$1" "${2:+ (e.g. $2)}" >&2; read -r answer || return 1; echo "$answer"
}

# ui_spin <title> <command...>: a spinner while an outside command runs. Its output only shows
# if it fails. Without gum it just runs the command (after printing the title).
ui_spin() {
  local title=$1
  shift
  if have_gum; then "$GUM" spin --title "$title" --show-error -- "$@" >&2; return; fi
  local out status=0
  [ -t 2 ] && say "${DIM}$title${RESET}"
  out=$("$@" 2>&1) || status=$?
  if [ "$status" != 0 ]; then printf '%s\n' "$out" >&2; fi
  return "$status"
}

# ui_bg <title> <function> [args...]: run a ccm function with a spinner and print what it printed.
ui_bg() {
  local title=$1 out pid status=0
  shift
  if ! have_gum; then "$@"; return; fi
  tmpdir
  out="$CCM_TMP/bg-$RANDOM"
  "$@" > "$out" &
  pid=$!
  "$GUM" spin --title "$title" -- sh -c "while kill -0 $pid 2>/dev/null; do sleep 0.1; done" >&2 || true
  wait "$pid" || status=$?
  cat "$out"
  return "$status"
}

ui_typed() {  # ui_typed <word> <what it does>: you have to type <word> to go ahead
  local answer
  if have_gum; then
    answer=$("$GUM" input --header "Type $1 to $2" --placeholder "$1") || return 1
  else
    printf 'Type %s to %s: ' "$1" "$2" >&2; read -r answer || return 1
  fi
  [ "$answer" = "$1" ]
}

ui_write() {  # ui_write <header> [placeholder]: a few lines of text (joined into one line)
  local answer
  if have_gum; then
    answer=$("$GUM" write --header "$1" --placeholder "${2:-}" --height 4 --show-line-numbers=false) || return 1
  else
    answer=$(ui_input "$1" "${2:-}") || return 1
  fi
  printf '%s\n' "$answer" | tr '\n' ' ' | sed 's/ *$//'
}

ui_confirm() {  # ui_confirm <question>
  local answer
  if have_gum; then "$GUM" confirm --default=false "$1"; return; fi
  printf '%s [y/N] ' "$1" >&2; read -r answer || return 1
  case $answer in [Yy]*) return 0 ;; *) return 1 ;; esac
}

yaml_set() {  # yaml_set <file> <key> <value>   (top-level key: "value")
  local v=${3//\\/\\\\}
  v=${v//\"/\\\"}
  KEY=$2 VAL=$v awk 'BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VAL"] }
    !done && $0 ~ "^#? *" k ":" { print k ": \"" v "\""; done = 1; next } { print }' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

slugify() {  # "While Loops!" -> while-loops
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//'
}

# name_conflict <name> [path to ignore]: prints what already uses this folder name, if anything.
# Names have to be unique across the whole curriculum so addresses like `ccm get loops` work.
name_conflict() {
  local name=$1 skip=${2:-} d rel kind
  while IFS= read -r d; do
    rel=${d#"$TREE"/}
    [ "$rel" = "$skip" ] && continue
    [ "$(dslug "$(basename "$d")")" = "$name" ] || continue
    kind=$(kind_of "$rel")
    case $kind in course|chapter|lesson|exercise) ;; *) continue ;; esac
    echo "the $kind $(addr_of "$rel") ($(title_of "$d" "$kind")) already uses '$name'"
    return 0
  done < <(find "$TREE/courses" -mindepth 1 -maxdepth 5 -type d -name "*-$name" 2>/dev/null)
  return 1
}

ask_slug() {  # ask_slug <what> <example> [path to ignore]: asks until the name is free
  local name="" typed why
  while :; do
    typed=$(ui_input "Folder name for the $1" "$2" "$name") || die "cancelled"
    name=$(slugify "$typed")
    if [ -z "$name" ]; then
      say "${RED}type a name, like $2${RESET}"
    elif why=$(name_conflict "$name" "${3:-}"); then
      say "${RED}✗ $why. Try another name.${RESET}"
    else
      [ "$name" = "$typed" ] || say "${DIM}using $name${RESET}"
      echo "$name"; return
    fi
  done
}

pick_child() {  # pick_child <header> <parent repo path> [e]  -> repo path of the chosen child
  local header=$1 parent=$2 pre=${3:-} d rel labels=() paths=() kind label
  for d in "$TREE/$parent"/"$pre"[0-9]*-*/; do
    [ -d "$d" ] || continue
    rel=${d#"$TREE"/}; rel=${rel%/}
    kind=$(kind_of "$rel")
    label=$(label_of "$rel")
    labels+=("$label"); paths+=("$rel")
  done
  [ "${#labels[@]}" -gt 0 ] || die "nothing to pick in $parent"
  label=$(ui_choose "$header" "${labels[@]}") || die "cancelled"
  local i
  for i in "${!labels[@]}"; do [ "${labels[$i]}" = "$label" ] && { echo "${paths[$i]}"; return; }; done
  die "cancelled"
}

interactive() { [ -t 0 ] && [ -t 2 ]; }

KIND_ORDER="course chapter lesson exercise"

kinds_upto() {  # kinds_upto <kind>: "course|chapter|..." up to and including <kind>
  local k out=""
  for k in $KIND_ORDER; do out="$out${out:+|}$k"; [ "$k" = "$1" ] && break; done
  echo "$out"
}

# pick_search <header> <kinds>: search everything of those kinds (e.g. "lesson|exercise") and
# return the repo path you pick. With gum it's one list you can type in; without gum it asks
# for a word and shows a numbered list of matches.
pick_search() {
  local header=$1 kinds=$2 lines line query
  lines=$(ui_bg "Loading the curriculum..." search_index | awk -v k="$kinds" '{ n = split(k, a, "|"); for (i = 1; i <= n; i++) if ($NF == a[i]) { print; next } }')
  [ -n "$lines" ] || die "there's nothing to pick yet"
  if have_gum; then
    line=$(printf '%s\n' "$lines" | "$GUM" filter --header "$header" --placeholder "Type to search, or use the arrow keys" --height 15) ||
      die "cancelled"
  else
    say "$header"
    query=$(ui_input "Search for" "while loops") || die "cancelled"
    local w hits=$lines
    for w in $query; do hits=$(printf '%s\n' "$hits" | grep -iF -- "$w" || true); done
    [ -n "$hits" ] || die "nothing found for '$query'"
    local opts=()
    while IFS= read -r line; do opts+=("$line"); done <<< "$hits"
    line=$(ui_choose "Which one?" "${opts[@]}") || die "cancelled"
  fi
  resolve "${line%% *}"
}

# pick_kind <header> <kind>: pick one course, chapter, lesson or exercise.
pick_kind() {
  if have_gum; then pick_search "$1" "$2"; return; fi
  local header=$1 want=$2 path=courses pick
  pick=$(ui_choose "$header" "Browse" "Search by name") || die "cancelled"
  if [ "$pick" = "Search by name" ]; then pick_search "$header" "$want"; return; fi
  while [ "$(kind_of "$path")" != "$want" ]; do
    if [ "$(kind_of "$path")" = lesson ]; then path=$(pick_child "$header" "$path" e); else path=$(pick_child "$header" "$path"); fi
  done
  echo "$path"
}

# pick_any <header> [deepest kind]: walk down course -> chapter -> lesson -> exercise and return
# the repo path you stop at. Each level offers "all of <it>" to pick the thing itself.
pick_any() {
  local header=$1 deepest=${2:-exercise} path=courses kind sub d rel labels paths label i here
  if have_gum; then pick_search "$header" "$(kinds_upto "$deepest")"; return; fi
  label=$(ui_choose "$header" "Browse" "Search by name") || die "cancelled"
  if [ "$label" = "Search by name" ]; then pick_search "$header" "$(kinds_upto "$deepest")"; return; fi
  while :; do
    kind=$(kind_of "$path")
    [ "$kind" = "$deepest" ] && { echo "$path"; return; }
    sub=$path; [ "$kind" = lesson ] && sub="$path/exercises"
    labels=(); paths=()
    if [ "$path" != courses ]; then
      here="all of $(label_of "$path")"
      labels+=("$here"); paths+=("$path")
    fi
    for d in "$TREE/$sub"/[0-9e]*-*/; do
      [ -d "$d" ] || continue
      rel=${d#"$TREE"/}; rel=${rel%/}
      case $(kind_of "$rel") in course|chapter|lesson|exercise) ;; *) continue ;; esac
      labels+=("$(label_of "$rel")"); paths+=("$rel")
    done
    if [ "${#paths[@]}" -le 1 ] && [ "$path" != courses ]; then echo "$path"; return; fi
    label=$(ui_choose "$header" "${labels[@]}") || die "cancelled"
    for i in "${!labels[@]}"; do
      if [ "${labels[$i]}" = "$label" ]; then
        [ "${paths[$i]}" = "$path" ] && { echo "$path"; return; }
        path=${paths[$i]}
        break
      fi
    done
  done
}

newest_child() {  # newest_child <parent dir> [e]  -> the highest-numbered child folder
  local d last=""
  for d in "$1"/"${2:-}"[0-9]*-*/; do [ -d "$d" ] && last=${d%/}; done
  echo "$last"
}

cmd_add() {
  TREE=$(repo_root add)
  local kind course chapter lesson name title desc dir files f
  ui_header "Add to the curriculum"
  kind=$(ui_choose "What do you want to add?" course chapter lesson exercise check-in) || die "cancelled"
  case $kind in
    course)
      name=$(ask_slug course object-oriented)
      title=$(ui_input "Title" "Object Oriented")
      desc=$(ui_write "Description (optional)" "What the students will learn")
      local slides=no
      ui_confirm "Will this course have slides?" && slides=yes
      say "Adding course '$name' ($title), slides: $slides"
      ui_confirm "Create it?" || die "cancelled"
      cmd_new course "$name"
      dir=$(newest_child "$TREE/courses")
      yaml_set "$dir/course.yaml" title "$title"
      yaml_set "$dir/course.yaml" description "$desc"
      if [ "$slides" = yes ]; then
        awk '{ if ($0 ~ /^# slides: true/) print "slides: true"; else print }' "$dir/course.yaml" > "$dir/course.yaml.tmp" &&
          mv "$dir/course.yaml.tmp" "$dir/course.yaml"
      fi ;;
    chapter)
      course=$(pick_kind "Which course does it go in?" course)
      name=$(ask_slug chapter loops)
      title=$(ui_input "Title" "Loops")
      desc=$(ui_write "Description (optional)" "What the students will learn")
      ui_confirm "Add chapter '$name' ($title) to $(addr_of "$course")?" || die "cancelled"
      cmd_new chapter "$(addr_of "$course")" "$name"
      dir=$(newest_child "$TREE/$course")
      yaml_set "$dir/chapter.yaml" title "$title"
      yaml_set "$dir/chapter.yaml" description "$desc" ;;
    lesson)
      chapter=$(pick_kind "Which chapter does it go in?" chapter)
      course=$(dirname "$chapter")
      name=$(ask_slug lesson while-loops)
      say "On the site this lesson will be called: $(basename "$name" | awk -F- '{ for (i = 1; i <= NF; i++) $i = toupper(substr($i, 1, 1)) substr($i, 2); print }')"
      local pre="lecture-notes.md,quiz"
      [ "$(yaml_scalar "$TREE/$course/course.yaml" slides)" = true ] && pre="$pre,slides.md"
      files=$(ui_multi "What should it have? (lecture.md is always included)" "$pre" \
              lecture-notes.md slides.md reading.md quiz practice) || die "cancelled"
      ui_confirm "Add lesson '$name' to $(addr_of "$chapter")?" || die "cancelled"
      cmd_new lesson "$(addr_of "$chapter")" "$name"
      dir=$(newest_child "$TREE/$chapter")
      cp -n "$TREE/shared/templates/lesson/slides.md" "$dir/" 2>/dev/null || true
      for f in lecture-notes.md slides.md reading.md quiz practice; do
        grep -qx "$f" <<< "$files" || rm -rf "${dir:?}/$f"
      done
      if ui_confirm "Add an exercise to it now?"; then add_exercise "${dir#"$TREE"/}"; fi ;;
    exercise)
      lesson=$(pick_kind "Which lesson does it go in?" lesson)
      add_exercise "$lesson" ;;
    check-in)
      lesson=$(pick_kind "Which lesson does it go after?" lesson)
      course=$(dirname "$(dirname "$lesson")")
      title=""
      while :; do
        title=$(ui_input "Title" "Check-in 1" "$title") || die "cancelled"
        name=$(slugify "$title")
        f="$TREE/$course/check-ins/$name.yaml"
        if [ -z "$name" ]; then say "${RED}type a title, like Check-in 1${RESET}"
        elif [ -e "$f" ]; then say "${RED}✗ there's already a check-in called '$title' in this course. Try another title.${RESET}"
        else break; fi
      done
      ui_confirm "Add '$title' after $(addr_of "$lesson")?" || die "cancelled"
      mkdir -p "$TREE/$course/check-ins"
      cp "$TREE/shared/templates/check-in.yaml" "$f"
      yaml_set "$f" title "$title"
      yaml_set "$f" after "${lesson#"$course"/}"
      say "${GREEN}created${RESET} ${f#"$TREE"/}" ;;
  esac
  say "Next: fill in the template, then run ccm validate."
}

add_exercise() {  # add_exercise <lesson repo path>
  local lesson=$1 name title type difficulty dir
  name=$(ask_slug exercise grade-calculator)
  title=$(ui_input "Title" "Grade Calculator")
  type=$(ui_choose "What kind of exercise?" \
         "practice      code playground on the lesson page" \
         "homework      its own assignment page" \
         "follow-along  students fill it in during the lesson") || die "cancelled"
  type=${type%% *}
  difficulty=$(ui_choose "Difficulty?" easy medium hard) || die "cancelled"
  ui_confirm "Add $type '$name' ($title) to $(addr_of "$lesson")?" || die "cancelled"
  cmd_new exercise "$(addr_of "$lesson")" "$name"
  dir=$(newest_child "$TREE/$lesson/exercises" e)
  yaml_set "$dir/prompt.md" title "$title"
  KEY_T=$type KEY_D=$difficulty awk '
    /^type:/ { print "type: " ENVIRON["KEY_T"] "     # follow-along | practice | homework"; next }
    /^difficulty:/ { print "difficulty: " ENVIRON["KEY_D"]; next } { print }' "$dir/prompt.md" > "$dir/prompt.md.tmp" &&
    mv "$dir/prompt.md.tmp" "$dir/prompt.md"
  sed -i.bak "s/<!-- name -->/$name/g" "$dir/prompt.md" && rm -f "$dir/prompt.md.bak"
  if [ "$type" = follow-along ]; then
    rm -rf "${dir:?}/tests"
    say "Follow-along files usually get a class name that fits the lesson (like Variables.java) instead of Main.java."
  fi
}

# ----------------------------------------------------------------- update ---

cmd_update() {
  local src self
  if src=$(local_source); then say "using local checkout $src; nothing to update (git pull instead)"; return; fi
  CCM_FORCE_FETCH=1
  REF=$(resolve_ref)
  TREE=$(tree_for "$REF")
  say "curriculum cache updated to $REF"
  self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
  if [ -f "$TREE/tools/ccm" ] && ! cmp -s "$TREE/tools/ccm" "$self"; then
    bash -n "$TREE/tools/ccm" || die "downloaded ccm has errors; not updating"
    if [ -w "$self" ]; then
      cp "$TREE/tools/ccm" "$self.new" && chmod +x "$self.new" && mv "$self.new" "$self"
      say "ccm updated ($self)"
    else
      warn "can't write $self; re-run the installer to update ccm"
    fi
  fi
}

# ------------------------------------------------------------------- main ---

usage() {
  cat <<EOF
ccm $CCM_VERSION — Charging Courses curriculum tool

  ccm list [address]          show courses, chapters and lessons (or one subtree)
  ccm get <address>...        download a course, chapter, lesson or exercise here
       -o, --out <dir>         download into <dir> instead of the current folder
  ccm test [address]          test your exercise code (run from anywhere near it)
  ccm search [words]          find a lesson or exercise
  ccm show [address]          read a lesson or exercise's instructions here
  ccm open [address]          open a lesson or homework on Charging Courses
  ccm doctor                  check that everything ccm needs is working
  ccm update                  refresh downloaded curriculum and ccm itself
  ccm version

Addresses:  1 (course)  1.2 (chapter)  1.2.1 (lesson)  1.2.1.e1 (exercise)
            names work too: if-statements, 1.2.if-statements.e1, grade-calc
EOF
  if is_instructor || [ "${1:-}" = --all ]; then
    cat <<EOF

Instructors (inside a clone of the repo):
  ccm get -i <address>        also download lecture notes and quizzes
  ccm add                     add material step by step
  ccm new <kind> ...          same in one line: course <name> | chapter|lesson|exercise <parent> <name>
  ccm mv <address> <name|n>   rename, or move to position n  (--into <address> to move elsewhere)
  ccm rm <address> [-y]       delete a course, chapter, lesson or exercise
  ccm validate                check structure, quizzes, links, check-ins
  ccm check                   run every exercise's tests against its solution
  ccm cases [--fill]          rebuild MainTest.java (--fill: run solutions to fill empty outputs)
  ccm export [address]        quizzes -> Markdown with answer keys
  ccm publish [folder]...     upload to Charging Courses (--dry-run, --force)
  ccm pull [address]          pick which site edits to bring back (a course, chapter or lesson)
  ccm release [--dry-run]     tag a release so students get the new material
  ccm instructor on|off       show these commands in ccm help everywhere

Environment: CCM_REF (version/branch), CCM_SOURCE (local checkout), CCM_CACHE, CCM_INSTRUCTOR, CCM_NO_GUM
EOF
  fi
}

main() {
  local cmd=${1:-help}
  [ $# -gt 0 ] && shift
  case $cmd in
    list|ls)          cmd_list "$@" ;;
    get)              cmd_get "$@" ;;
    test)             cmd_test "$@" ;;
    update)           cmd_update "$@" ;;
    new)              cmd_new "$@" ;;
    add)              cmd_add "$@" ;;
    mv|move)          cmd_mv "$@" ;;
    pull)             cmd_pull "$@" ;;
    open)             cmd_open "$@" ;;
    search|find)      cmd_search "$@" ;;
    show|read)        cmd_show "$@" ;;
    doctor)           cmd_doctor "$@" ;;
    release)          cmd_release "$@" ;;
    instructor)       cmd_instructor "$@" ;;
    remove|rm)        cmd_remove "$@" ;;
    validate)         run_tool validate validate/validate.py "$@" ;;
    check)            cmd_check "$@" ;;
    cases)            run_tool cases cases.py "$@" ;;
    export)           run_tool export export/quiz.py "$@" ;;
    publish)          run_tool publish lms/publish.py "$@" ;;
    version|--version|-v) echo "ccm $CCM_VERSION" ;;
    help|--help|-h)   usage "$@" ;;
    _test-dir)        cmd_test_dir "$@" ;;
    _compile-dir)     cmd_compile_dir "$@" ;;
    *) die "unknown command '$cmd' (see: ccm help)" ;;
  esac
}

main "$@"
